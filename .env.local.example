# Hugging Face Inference API Token
# Required for AI image generation feature
#
# How to get your API token:
# 1. Sign up for a free account at https://huggingface.co/
# 2. Go to https://huggingface.co/settings/tokens
# 3. Click "New token" and give it a name (e.g., "inner-tides")
# 4. IMPORTANT: Enable "Make calls to serverless Inference API" permission
# 5. Click "Generate token"
# 6. Copy the token and paste it below
# 7. Rename this file to .env.local
#
# Free tier includes:
# - Rate limited but sufficient for development
# - Stable Diffusion XL model for image generation
# - Can upgrade to Pro ($9/month) for faster inference
#
# Note: Without this token, the app will use placeholder images instead

NEXT_PUBLIC_HF_API_TOKEN=your_huggingface_api_token_here
